{
	// Cloudflare Worker: static PWA assets + /api backed by D1 and KV.
	// All services used here are on the Workers free plan (see docs/PLAN.md §8.1).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "benkyo-ne",
	"account_id": "6a39e1996771186d5fdbb420ba3046e1",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"routes": [{ "pattern": "benkyo.jirachai.me", "custom_domain": true }],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		// Unknown paths serve index.html so client-side routes work.
		"not_found_handling": "single-page-application",
		// Only /api/* runs Worker code; everything else is served as free static assets.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "benkyo",
			// Created with: npx wrangler d1 create benkyo
			"database_id": "2d2d6a80-5708-4e90-8e1f-fbe38802d31a",
			"migrations_dir": "worker/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONTENT",
			// Created with: npx wrangler kv namespace create CONTENT
			"id": "f6d21a3071e54dff95ecd4034e0fe1a7"
		}
	],
	"observability": { "enabled": true }
}
