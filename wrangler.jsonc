{
	// Cloudflare Worker: static PWA assets + /api backed by D1 and KV.
	// All services used here are on the Workers free plan (see docs/PLAN.md §8.1).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "benkyo-ne",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		// Unknown paths serve index.html so client-side routes work.
		"not_found_handling": "single-page-application",
		// Only /api/* runs Worker code; everything else is served as free static assets.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "benkyo",
			// Replace with the id printed by: npx wrangler d1 create benkyo
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "worker/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONTENT",
			// Replace with the id printed by: npx wrangler kv namespace create CONTENT
			"id": "00000000000000000000000000000000"
		}
	],
	"observability": { "enabled": true }
}
