{
  "name": "benkyo-ne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:strokes": "node scripts/build-strokes.mjs",
    "db:migrate:local": "wrangler d1 migrations apply benkyo --local",
    "db:migrate:remote": "wrangler d1 migrations apply benkyo --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "wrangler d1 migrations apply benkyo --remote && wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "cf:deploy:embedded": "npm run build && node scripts/embed-assets.mjs && wrangler deploy -c wrangler.embedded.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
