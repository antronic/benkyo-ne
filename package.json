{
  "name": "benkyo-ne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-avatar-vendor.mjs && vite dev",
    "build": "node scripts/copy-avatar-vendor.mjs && vite build && npm run build-storybook",
    "preview": "wrangler dev --infer-origin-from-routes=false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:ui": "node scripts/check-spacing.mjs && node scripts/check-ui.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:render": "node scripts/check-render.mjs",
    "test": "vitest run",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:strokes": "node scripts/build-strokes.mjs",
    "db:migrate:local": "wrangler d1 migrations apply benkyo --local",
    "db:migrate:remote": "wrangler d1 migrations apply benkyo --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "wrangler d1 migrations apply benkyo --remote && wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "cf:deploy:embedded": "npm run build && node scripts/embed-assets.mjs && wrangler deploy -c wrangler.embedded.jsonc",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o build/storybook --quiet",
    "check:storybook": "node scripts/check-storybook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/svelte-vite": "^10.6.8",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "storybook": "^10.6.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@antronic/coreva-render": "0.7.0",
    "@johnmorrisdotca/jisho": "2.11.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "three": "0.170.0"
  }
}
